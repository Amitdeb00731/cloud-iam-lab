{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAccountPrincipalsWithMFA",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::963910216975:root" },
      "Action": "sts:AssumeRole",
      "Condition": {
        "Bool": { "aws:MultiFactorAuthPresent": "true" }
      }
    }
  ]
}
