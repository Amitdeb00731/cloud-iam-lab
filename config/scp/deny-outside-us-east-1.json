{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyOutsideUsEast1",
      "Effect": "Deny",
      "NotAction": [
        "iam:*",
        "sts:*",
        "organizations:*",
        "sso:*",
        "sso-directory:*",
        "identitystore:*",
        "cloudfront:*",
        "route53:*",
        "route53domains:*",
        "waf:*",
        "wafv2:*",
        "shield:*",
        "globalaccelerator:*",
        "support:*",
        "budgets:*",
        "cur:*",
        "ce:*",
        "account:*",
        "freetier:*",
        "health:*",
        "notifications:*",
        "trustedadvisor:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}
